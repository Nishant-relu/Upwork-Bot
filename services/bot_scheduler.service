[Unit]
Description=Bot Scheduler Service
After=network.target

[Service]
Type=simple
User=naman
WorkingDirectory=/home/naman/Desktop/projects/upwork_bot
ExecStart=/home/naman/Desktop/projects/upwork_bot/.venv/bin/python3 /home/naman/Desktop/projects/upwork_bot/bot_scheduler.py
ExecStop=/home/naman/Desktop/projects/upwork_bot/.venv/bin/python3 /home/naman/Desktop/projects/upwork_bot/stop_bot.py
EnvironmentFile=/home/naman/Desktop/projects/upwork_bot/.env
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
